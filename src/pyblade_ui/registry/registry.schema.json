{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PyBlade UI registry",
  "type": "object",
  "required": ["name", "items"],
  "properties": {
    "name": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "files"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "type": { "enum": ["registry:ui", "registry:block", "registry:lib"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "files": {
            "description": "Paths relative to the registry, also where each file lands inside the project's components directory.",
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "registryDependencies": { "type": "array", "items": { "type": "string" } },
          "dependencies": {
            "type": "object",
            "properties": {
              "js": { "type": "array", "items": { "type": "string" } },
              "python": { "type": "array", "items": { "type": "string" } }
            }
          },
          "usage": { "type": "string" }
        }
      }
    }
  }
}
